select 
  n.ins_claim_no, 
  n.claim_status,
  g.claim_intimation_response->>'RejectionMsg' as rejection_reason
from claimintimationdtls n
join claimgcintegrationdtls g on n.ins_claim_no = g.ins_claim_no
where n.ins_claim_no in (
  '400701201125110060201',
  '400304201125110015201',
  '200601201125110057001',
  '400304201125110018301',
  '500107201125110018401'
  -- yahan baaki saare claim numbers bhi comma laga ke add karo
);
