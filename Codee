select 
  g.claim_intimation_response->>'RejectionMsg' as rejection_reason,
  count(*)
from claimintimationdtls n
join claimgcintegrationdtls g on n.visof_claim_no = g.visof_claim_no
where n.oem_name ilike '%MARUTI%'
  and n.claim_status = 'FAILED'
  and n.last_updated_timestamp >= now() - interval '7 days'
group by rejection_reason
order by count(*) desc;
