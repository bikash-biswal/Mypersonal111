select n.visof_claim_no, n.claim_status, g.claim_intimation_response
from claimintimationdtls n
join claimgcintegrationdtls g on n.visof_claim_no = g.visof_claim_no
where n.oem_name ilike '%MARUTI%'
  and n.claim_status = 'FAILED'
  and n.ins_claim_no is null
order by n.last_updated_timestamp desc
limit 18;
